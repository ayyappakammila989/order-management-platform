        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "orderId",
      "type": "string"
    },
    {
      "name": "paymentId",
      "type": "string"
    },
    {
      "name": "refundId",
      "type": "string"
    },
    {
      "name": "returnId",
      "type": [
        "null",
        "string"
      ],
