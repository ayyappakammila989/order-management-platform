{
  "realm": "oms",
  "displayName": "Order Management Platform",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 43200,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Shoppers: own cart, own orders, own returns, own profile",
        "composite": false
      },
      {
        "name": "SUPPORT_AGENT",
        "description": "Call-centre agents: search all orders, view details, cancel unshipped orders, create returns, refunds up to $200, use chatbot",
        "composite": false
      },
      {
        "name": "SUPPORT_SUPERVISOR",
        "description": "Team leads: everything an agent can + refunds above $200 + approve flagged returns",
        "composite": true,
        "composites": {
          "realm": [
            "SUPPORT_AGENT"
          ]
        }
      },
      {
        "name": "OPS_ADMIN",
        "description": "Operations team: integration screens, view and retry failed SAP / carrier messages, run SFTP jobs",
        "composite": false
      },
      {
        "name": "FINANCE",
        "description": "Finance team: payment history, reconciliation reports, daily sales reports",
        "composite": false
      },
      {
        "name": "SERVICE",
        "description": "Backend services: /internal/** APIs only",
        "composite": false
      }
    ]
  },
  "groups": [
    {
      "name": "customers",
      "path": "/customers",
      "realmRoles": [
        "CUSTOMER"
      ]
    },
    {
      "name": "employees",
      "path": "/employees"
    }
  ],
  "defaultGroups": [
    "/customers"
  ],
  "clients": [
    {
      "clientId": "mobile-app",
      "name": "Mobile app (React Native)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "com.retail.oms.mobile://callback",
        "http://localhost:8081/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+",
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "36000"
      },
      "protocolMappers": [
        {
          "name": "oms-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "oms-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
